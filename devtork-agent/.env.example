# ============================================================
# DevTork AI Agent - Environment Variables Template
#
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to git (it's in .gitignore).
#
# Fields marked [Phase X] are not used yet -- they are listed here
# now so the file structure is stable, but the code that reads them
# is added in that phase, as explained when we get there.
# ============================================================

# --- App ---
APP_ENV=development
DEBUG=true

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Database [Phase 2] ---
POSTGRES_USER=devtork
POSTGRES_PASSWORD=devtork_dev_password
POSTGRES_DB=devtork_agent
DATABASE_URL=postgresql://devtork:devtork_dev_password@db:5432/devtork_agent

# --- Auth [Phase 3] ---
SECRET_KEY=

# --- Gemini AI [Phase 4] ---
GEMINI_API_KEY=

# --- Notifications [Phase 12] ---
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
